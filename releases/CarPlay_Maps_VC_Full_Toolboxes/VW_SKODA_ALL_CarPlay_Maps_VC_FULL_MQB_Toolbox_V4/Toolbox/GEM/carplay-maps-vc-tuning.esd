###########################################################################
# CarPlay Maps VC - experimental stream tuning (MU1427 / 791 only)
# Each entry swaps core.so; a full unit reboot is required afterwards.
# Collect diagnostics before rebooting, the logs live in /ramdisk.
###########################################################################
screen carplay-maps-vc-tuning carplay-maps-vc

keyValue
    value   String sys 0x00000000 0
    label   "Experimental - MU1427 / 791 only"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Reboot after each swap; collect diagnostics first"
    poll    0

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_stock.sh"
    label   "Stock: 40 fps, keyframe every 20 frames"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_fps30.sh"
    label   "30 fps, keyframe every 20 frames (no card)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card.sh"
    label   "40 fps + turn card, original position"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y120_w400.sh"
    label   "30 fps + narrow turn card, top at y=120"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y80_w400.sh"
    label   "30 fps + narrow turn card, top at y=80"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y88_w400.sh"
    label   "30 fps + narrow turn card, top at y=88"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y96_w400.sh"
    label   "30 fps + narrow turn card, top at y=96"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y88_h312.sh"
    label   "30 fps + turn card y=88, safe area height 312"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y88_h240.sh"
    label   "30 fps + turn card y=88, safe area height 240"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_tune_card_y88_h160.sh"
    label   "30 fps + turn card y=88, safe area height 160"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_status.sh"
    label   "Show CarPlay Maps VC status (active tuning)"
